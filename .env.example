# Server (§69.6). Copy to .env and fill in; .env is gitignored.
PORT=3001
CORS_ORIGINS=*
NODE_ENV=development

# Client. Leave unset in development — the Vite proxy handles /socket.io.
# VITE_SERVER_URL=https://your-server.onrender.com

# Voice — Phase 6 only (§69.1). Not needed until then.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
