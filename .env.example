# Server (§69.6). Copy to .env and fill in; .env is gitignored.
PORT=3001
CORS_ORIGINS=*
NODE_ENV=development

# Client. Leave unset in development — the Vite proxy handles /socket.io.
# VITE_SERVER_URL=https://your-server.onrender.com

# Voice (§69). Leave blank to disable voice entirely — the game plays normally
# without it. Get these from https://cloud.livekit.io (free Build plan).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=