{
  "name": "memory-card-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time team-based Literature (Fish) card game. See memory-card-game-specification.md",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace server",
    "test:watch": "npm run test:watch --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace @memory-game/server",
    "dev:server": "npm run dev --workspace @memory-game/server",
    "dev:client": "npm run dev --workspace @memory-game/client"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
